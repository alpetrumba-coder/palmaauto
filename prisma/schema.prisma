// Prisma: схема БД и генератор клиента.
// Документация: https://www.prisma.io/docs

generator client {
  provider      = "prisma-client-js"
  // Vercel (Linux): корректный query engine в проде
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // URL берётся из .env — не храните реальные пароли в репозитории
  url      = env("DATABASE_URL")
}

// --- Заготовка этапа 1: минимальная модель под будущих пользователей ---
// На следующих этапах сюда добавят Car, CarImage, Booking и поля профиля.

/// Роль в системе: клиент сайта или полный доступ (админ-панель).
enum UserRole {
  CUSTOMER
  ADMIN
}

/// Пользователь: вход по email/паролю (хэш в passwordHash).
model User {
  id           String               @id @default(cuid())
  /// Уникальный email для входа и связи
  email        String               @unique
  /// Bcrypt-хэш пароля; null — вход по паролю недоступен (старые записи).
  passwordHash String?              @map("password_hash")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  role         UserRole             @default(CUSTOMER)
  /// Профиль клиента (редактирование в админ-панели и позже в личном кабинете).
  lastName     String?              @map("last_name")
  firstName    String?              @map("first_name")
  patronymic   String?
  phone        String?
  address      String?              @db.Text
  /// Паспортные данные (серия, номер, кем выдан); хранить и показывать только доверенным ролям.
  passportData String?              @map("passport_data") @db.Text
  /// Возраст полных лет (для договора аренды).
  ageYears     Int?                 @map("age_years")
  /// Серия паспорта (структурировано для PDF договора).
  passportSeries   String?          @map("passport_series")
  passportNumber   String?          @map("passport_number")
  passportIssuedBy String?          @map("passport_issued_by") @db.Text
  /// Дата обезличивания/удаления персональных данных (по запросу или по ретеншну).
  personalDataErasedAt DateTime?    @map("personal_data_erased_at")
  resetTokens  PasswordResetToken[]
  bookings     Booking[]
  consents     ConsentRecord[]
  personalDataErasures PersonalDataErasure[] @relation("erasure_user")
  performedPersonalDataErasures PersonalDataErasure[] @relation("erasure_performed_by")

  @@map("users")
}

/// Одноразовый токен сброса пароля (в БД хранится хэш токена из письма).
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Автомобиль в автопарке (витрина: только active = true).
model Car {
  id              String     @id @default(cuid())
  /// Стабильный URL-сегмент, например toyota-camry
  slug            String     @unique
  make            String
  model           String
  description     String     @db.Text
  /// Цена за сутки в целых рублях (без копеек).
  pricePerDayRub  Int        @map("price_per_day_rub")
  /// Минимальный срок аренды в сутках (включительно).
  minRentalDays   Int        @default(1) @map("min_rental_days")
  /// Данные для договора аренды (PDF).
  modelYear                 Int?    @map("model_year")
  color                     String?
  plateNumber               String? @map("plate_number")
  registrationCertificate   String? @map("registration_certificate") @db.Text
  /// Порядок на витрине (меньше — выше в списке).
  sortOrder         Int        @default(100) @map("sort_order")
  /// Ссылка на видео ВКонтакте (vk.com / vkvideo.ru).
  videoUrl          String?    @map("video_url") @db.VarChar(500)
  active          Boolean    @default(true)
  /// Тестовая машина: не показывается на сайте и не учитывается в отчётах.
  isTest          Boolean    @default(false) @map("is_test")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  images          CarImage[]
  bookings        Booking[]

  @@map("cars")
}

/// Статус брони: оплата и отмена — на следующих этапах.
enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum BookingPaymentPlan {
  FULL
  FIRST_DAY
}

enum BookingPlaceMode {
  OFFICE
  ADDRESS
}

enum ConsentType {
  PDP
  MARKETING
}

/// Бронь: startDate — выдача, endDate — возврат; сутки считаются по ночам между датами.
model Booking {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  carId         String        @map("car_id")
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  status        BookingStatus @default(PENDING_PAYMENT)
  paymentPlan   BookingPaymentPlan @default(FULL) @map("payment_plan")
  paidAmountRub Int           @default(0) @map("paid_amount_rub")
  totalPriceRub Int           @map("total_price_rub")
  pickupMode    BookingPlaceMode @default(OFFICE) @map("pickup_mode")
  pickupAddress String?          @map("pickup_address") @db.Text
  pickupFeeRub  Int              @default(0) @map("pickup_fee_rub")
  pickupTimeSlot String?         @map("pickup_time_slot") @db.VarChar(20)
  dropoffMode   BookingPlaceMode @default(OFFICE) @map("dropoff_mode")
  dropoffAddress String?         @map("dropoff_address") @db.Text
  dropoffFeeRub Int              @default(0) @map("dropoff_fee_rub")
  dropoffTimeSlot String?        @map("dropoff_time_slot") @db.VarChar(20)
  secondDriverEnabled Boolean @default(false) @map("second_driver_enabled")
  secondDriverFirstName String? @map("second_driver_first_name")
  secondDriverLastName String? @map("second_driver_last_name")
  secondDriverAgeYears Int? @map("second_driver_age_years")
  secondDriverPassportData String? @map("second_driver_passport_data") @db.Text
  secondDriverFeeRub Int @default(0) @map("second_driver_fee_rub")
  childSeatEnabled Boolean @default(false) @map("child_seat_enabled")
  childSeatFeeRub Int @default(0) @map("child_seat_fee_rub")
  /// Снимок данных арендатора для генерации договора (PDF).
  contractMeta  Json?       @map("contract_meta")
  /// Комментарий администратора к заказу (только админ-панель).
  adminComment  String?     @map("admin_comment") @db.Text
  /// Тестовый заказ: не учитывается в отчётах.
  isTest        Boolean       @default(false) @map("is_test")
  consents      ConsentRecord[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  car           Car           @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([carId])
  @@map("bookings")
}

model ConsentRecord {
  id         String      @id @default(cuid())
  type       ConsentType
  docVersion String      @map("doc_version") @db.VarChar(40)
  docPath    String      @map("doc_path") @db.VarChar(200)
  acceptedAt DateTime    @default(now()) @map("accepted_at")
  ip         String?     @db.VarChar(80)
  userAgent  String?     @map("user_agent") @db.Text
  userId     String?     @map("user_id")
  bookingId  String?     @map("booking_id")
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking    Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([type, acceptedAt])
  @@map("consent_records")
}

model PersonalDataErasure {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  performedById String?  @map("performed_by_id")
  performedAt   DateTime @default(now()) @map("performed_at")
  reason        String   @db.VarChar(120)
  note          String?  @db.Text

  user          User     @relation("erasure_user", fields: [userId], references: [id], onDelete: Cascade)
  performedBy   User?    @relation("erasure_performed_by", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([performedAt])
  @@map("personal_data_erasures")
}

/// Фото автомобиля: пока внешний URL (этап 5 — загрузка в S3).
model CarImage {
  id        String   @id @default(cuid())
  carId     String   @map("car_id")
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  alt       String?
  createdAt DateTime @default(now()) @map("created_at")
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@map("car_images")
}

/// Дополнительные услуги (Приложение №3 к договору): цена за сутки и/или текст фиксированной цены.
model ExtraService {
  id                 String   @id @default(cuid())
  name               String
  pricePerDayRub     Int      @default(0) @map("price_per_day_rub")
  nonDailyPriceText  String?  @map("non_daily_price_text") @db.VarChar(200)
  sortOrder          Int      @default(0) @map("sort_order")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("extra_services")
}

// ============================================================================
// Учёт «Пальма»: справочники и сотрудники (этап 1 плана docs/PLAN-UCHET.md)
// ============================================================================

enum StaffRole {
  OWNER
  OPERATOR
}

/// Сотрудник с личным входом в админ-панель (отдельно от клиентов сайта).
model StaffUser {
  id           String    @id @default(cuid())
  /// Логин для входа (email), в нижнем регистре.
  login        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         StaffRole @default(OPERATOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("staff_users")
}

/// Проект (юрлицо/направление) из учёта УК: УН, Проект N, Библая В. и т.д.
model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  assets    Asset[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("projects")
}

enum AssetKind {
  APARTMENT
  CAR
}

/// Объект учёта: квартира/дом или автомобиль.
model Asset {
  id           String    @id @default(cuid())
  kind         AssetKind
  name         String
  /// Адрес или госномер.
  address      String?
  projectId    String?   @map("project_id")
  /// Внешний собственник (имя). Пусто — объект компании: расчёт «доли собственника» не нужен.
  ownerName    String?   @map("owner_name")
  /// Доля внешнего собственника в % (остаток — УК); имеет смысл, только если ownerName задан.
  ownerSharePct Int      @default(65) @map("owner_share_pct")
  /// Название объекта в RealtyCalendar (для сопоставления броней).
  rcName       String?   @map("rc_name")
  /// Как объект назывался в УК.xlsx (для импорта истории), по одному названию в строке.
  aliases      String?   @db.Text
  /// Связь с машиной сайта проката (slug из таблицы cars).
  carSlug      String?   @map("car_slug")
  sortOrder    Int       @default(0) @map("sort_order")
  active       Boolean   @default(true)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deals        Deal[]
  operations   Operation[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([kind, name])
  @@map("assets")
}

enum CashAccountKind {
  CARD
  CASH
  ONLINE
}

/// Касса / счёт: карта, наличные у сотрудника, онлайн-кошелёк.
model CashAccount {
  id          String          @id @default(cuid())
  name        String          @unique
  kind        CashAccountKind
  /// Ответственный (имя) — чьи деньги.
  responsible String?
  /// Начальный остаток в копейках (на дату начала учёта в системе).
  openingKop  Int             @default(0) @map("opening_kop")
  sortOrder   Int             @default(0) @map("sort_order")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  operations  Operation[]     @relation("OperationAccount")
  incoming    Operation[]     @relation("OperationToAccount")

  @@map("cash_accounts")
}

enum CategoryKind {
  INCOME
  EXPENSE
}

/// Переменный расход относится к конкретному заезду/аренде; постоянный — распределяется по объектам.
enum CategoryNature {
  VARIABLE
  FIXED
}

/// Статья доходов/расходов (очищенный справочник из УК.xlsx).
model Category {
  id        String         @id @default(cuid())
  name      String         @unique
  kind      CategoryKind
  nature    CategoryNature @default(VARIABLE)
  sortOrder Int            @default(0) @map("sort_order")
  active    Boolean        @default(true)
  /// Названия статьи в УК.xlsx (для импорта истории), по одному названию в строке.
  aliases   String?        @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  operations Operation[]

  @@map("categories")
}

/// Площадка/канал продаж с комиссией по сезону.
model Channel {
  id                String   @id @default(cuid())
  name              String   @unique
  /// Комиссия площадки в % (низкий сезон / высокий сезон).
  commissionLowPct  Int      @default(0) @map("commission_low_pct")
  commissionHighPct Int      @default(0) @map("commission_high_pct")
  sortOrder         Int      @default(0) @map("sort_order")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  deals             Deal[]

  @@map("channels")
}

// ============================================================================
// Учёт «Пальма»: заезды/аренды и журнал операций (этап 2)
// Деньги — целые копейки. Операции не удаляются, а аннулируются (voidedAt).
// ============================================================================

enum DealStatus {
  ACTIVE
  CANCELLED
}

/// Заезд (квартира) или аренда авто: сумма, срок, оплаты и расходы цепляются операциями.
model Deal {
  id             String      @id @default(cuid())
  /// Сквозной номер для людей («Заезд №123»).
  number         Int         @unique @default(autoincrement())
  assetId        String      @map("asset_id")
  channelId      String?     @map("channel_id")
  guestName      String      @map("guest_name")
  phone          String?
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  /// Сумма заезда/аренды, которую платит гость (брутто), коп.
  grossKop       Int         @map("gross_kop")
  /// Комиссия площадки, коп.
  commissionKop  Int         @default(0) @map("commission_kop")
  comment        String?     @db.Text
  status         DealStatus  @default(ACTIVE)
  /// Бронь сайта проката (на будущее, этап 5).
  siteBookingId  String?     @unique @map("site_booking_id")
  createdBy      String      @map("created_by")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  asset          Asset       @relation(fields: [assetId], references: [id])
  channel        Channel?    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  operations     Operation[]

  @@index([assetId, startDate])
  @@index([startDate])
  @@map("deals")
}

enum OperationType {
  INCOME
  EXPENSE
  /// Перемещение между нашими кассами.
  TRANSFER
  /// Сдача денег во внешнюю кассу (Рубин): деньги уходят из нашей кассы, это не расход.
  HANDOVER
}

/// Строка журнала: приход, расход, перемещение или сдача в Рубин.
model Operation {
  id          String        @id @default(cuid())
  number      Int           @unique @default(autoincrement())
  date        DateTime      @db.Date
  type        OperationType
  amountKop   Int           @map("amount_kop")
  /// Касса: куда пришло (INCOME) или откуда ушло (EXPENSE, TRANSFER, HANDOVER).
  accountId   String        @map("account_id")
  /// Только для TRANSFER: касса-получатель.
  toAccountId String?       @map("to_account_id")
  categoryId  String?       @map("category_id")
  assetId     String?       @map("asset_id")
  dealId      String?       @map("deal_id")
  comment     String?       @db.Text
  createdBy   String        @map("created_by")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  voidedAt    DateTime?     @map("voided_at")
  voidedBy    String?       @map("voided_by")
  /// Перенесено из старой истории (УК.xlsx): не влияет на остатки касс, остатки задаются вручную.
  isImported  Boolean       @default(false) @map("is_imported")
  /// Откуда взято: «uk:<строка в УК.xlsx>»; уникально — повторный импорт не создаёт дублей.
  sourceRef   String?       @unique @map("source_ref")
  /// Требует проверки человеком (расхождение с 1С, нераспознанная касса и т.п.); в отчёты не попадает до решения.
  needsReview Boolean       @default(false) @map("needs_review")
  reviewNote  String?       @map("review_note")
  account     CashAccount   @relation("OperationAccount", fields: [accountId], references: [id])
  toAccount   CashAccount?  @relation("OperationToAccount", fields: [toAccountId], references: [id])
  category    Category?     @relation(fields: [categoryId], references: [id])
  asset       Asset?        @relation(fields: [assetId], references: [id])
  deal        Deal?         @relation(fields: [dealId], references: [id])

  @@index([date])
  @@index([accountId])
  @@index([dealId])
  @@index([assetId])
  @@index([needsReview])
  @@map("operations")
}
